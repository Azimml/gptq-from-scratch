# EditorConfig: https://editorconfig.org
# Keeps whitespace consistent across editors, matching the ruff config in
# pyproject.toml (line-length 100, spaces for indentation).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.py]
indent_size = 4

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
# Trailing whitespace can be meaningful in Markdown (two spaces = line break).
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
